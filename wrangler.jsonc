{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gumshop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "gumshop.online/*", "zone_name": "gumshop.online" },
    { "pattern": "*.gumshop.online/*", "zone_name": "gumshop.online" }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://rkdigvwkcbbysuvilkzp.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_kS8eq_QMEg5qLnsJxAIqCg_eYTuU6uP",
    "SUPABASE_SERVICE_ROLE_KEY": "sb_publishable_kS8eq_QMEg5qLnsJxAIqCg_eYTuU6uP",
    "NEXT_PUBLIC_APP_URL": "https://www.gumshop.online",
    "NEXT_PUBLIC_BASE_URL": "https://www.gumshop.online",
    "ADMIN_PASSWORD": "Meetminal@0406"
  },
  "observability": {
    "enabled": true
  }
}
