# GumShop Backend Environment Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_chars_min

# Optional: PostgreSQL Database URL (falls back to local persistent JSON file if omitted)
# DATABASE_URL=postgresql://username:password@localhost:5432/gumshop

# Optional: Global Gumroad Access Token
# GUMROAD_ACCESS_TOKEN=
