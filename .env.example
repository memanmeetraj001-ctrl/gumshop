# ==============================================================================
# GumShop SaaS — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or API keys to version control!
# ==============================================================================

# === Server Configuration ===
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# === Authentication & Security ===
# Generate a strong 64-character random string for production
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Default seeded admin credentials (first boot only)
ADMIN_EMAIL=admin@gumshop.online
ADMIN_PASSWORD=change_this_admin_password_123

# === Database ===
# Optional: Neon PostgreSQL connection string (defaults to local file-based JSON DB)
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/gumshop?sslmode=require

# === Gumroad Storefront Sync ===
GUMROAD_STORE_URL=https://yourstore.gumroad.com
GUMROAD_ACCOUNT=your_gumroad_username

# === Lemon Squeezy SaaS Billing & Subscriptions ===
# From Lemon Squeezy Dashboard > Settings > API Keys
LEMONSQUEEZY_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGci...your_api_key_here

# From Lemon Squeezy Dashboard > Settings > Webhooks (Endpoint: /api/billing/ls/webhook)
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Your Lemon Squeezy Store Identifier
LEMONSQUEEZY_STORE_SLUG=gumshop
LEMONSQUEEZY_STORE_ID=465378

# Lemon Squeezy Product Variant IDs
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=2082941
LEMONSQUEEZY_VARIANT_PRO_ANNUAL=2082945
LEMONSQUEEZY_VARIANT_SCALE_MONTHLY=2082951
LEMONSQUEEZY_VARIANT_SCALE_ANNUAL=2082952

# === Frontend (Vite) Client-Side Variables ===
# Must begin with VITE_ to be exposed to client-side code
VITE_API_URL=http://localhost:5000