# ==============================================================================
# GumShop SaaS — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or API keys to version control!
# ==============================================================================

# === Server Configuration ===
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# === Authentication & Security ===
# Generate a strong 64-character random string for production
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Default seeded admin credentials (first boot only)
ADMIN_EMAIL=admin@gumshop.online
ADMIN_PASSWORD=change_this_admin_password_123

# === Database ===
# Optional: Neon PostgreSQL connection string (defaults to local file-based JSON DB)
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/gumshop?sslmode=require

# === Gumroad SaaS Billing & Storefront Sync ===
GUMROAD_STORE_URL=https://manmeetraj6.gumroad.com
GUMROAD_ACCOUNT=manmeetraj6

# Gumroad Subscription Product URLs
GUMROAD_PRO_MONTHLY_URL=https://manmeetraj6.gumroad.com/l/gumshop-pro
GUMROAD_PRO_ANNUAL_URL=https://manmeetraj6.gumroad.com/l/gumshop-pro-annual
GUMROAD_SCALE_MONTHLY_URL=https://manmeetraj6.gumroad.com/l/gumshop-scale
GUMROAD_SCALE_ANNUAL_URL=https://manmeetraj6.gumroad.com/l/gumshop-scale-annual

# === Frontend (Vite) Client-Side Variables ===
# Must begin with VITE_ to be exposed to client-side code
VITE_API_URL=http://localhost:5000