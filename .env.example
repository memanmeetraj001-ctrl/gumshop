# =============================================
# WashForge Environment Configuration
# =============================================

# === Backend API Port ===
PORT=5000

# === JWT Secret (generate a 64-char random string for production) ===
JWT_SECRET=washforge_super_secret_jwt_key_change_this_in_production

# === Admin Email (seeded on first run) ===
ADMIN_EMAIL=admin@washforge.com
ADMIN_PASSWORD=admin123

# === Database ===
# For Neon PostgreSQL (production):
# Get free DB at https://neon.tech
# Format: postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# === Gumroad ===
# Your Gumroad storefront base URL (configured in Admin Panel too)
GUMROAD_STORE_URL=https://washforge.gumroad.com

# === Frontend (Vite) ===
# Public base URL for the storefront (no trailing slash)
VITE_API_URL=http://localhost:5000

# =============================================
# Deployment on Vercel:
# 1. Connect your GitHub repo in Vercel dashboard
# 2. Set DATABASE_URL to your Neon PostgreSQL connection string
# 3. Set JWT_SECRET to a secure random string
# 4. Set custom domain to mckillanscarcare.online
# 5. Deploy ? Vercel will auto-detect vercel.json config
# =============================================